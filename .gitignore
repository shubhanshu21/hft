# ==============================================================================
# Git Ignore Rules — Multi-Asset Quantitative Trading Framework
# ==============================================================================

# Runtime state -- everything the system writes while running lives under
# backend/var/ (market archives, caches, logs, SQLite DB). Code never does.
backend/var/

# Data Files & Datasets (CSVs, HDF5, Parquet, Archives)
*.csv
*.csv.gz
*.parquet
*.h5
*.hdf5

# Machine Learning Models, Pickles & Caches
*.pkl
*.pickle
*.joblib
*.model
catboost_info/
.cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python Bytecode & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/


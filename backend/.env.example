# ==============================================================================
# Automated Trading Bot — Environment Configuration
# NEVER commit the .env file to version control.
# ==============================================================================

# ── UPSTOX CREDENTIALS (the only broker account) ──────────────────────────────
# Get these from: https://developer.upstox.com/
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://127.0.0.1/

# ACCESS_TOKEN is NOT stored here -- it's rewritten too often (daily at
# minimum) for a file meant to hold static app credentials. See
# cache/upstox_token.json (auto-created/updated by auth.upstox_auth /
# auth.upstox_auto_login).

# Optional — enables auth/upstox_auto_login.py's headless daily token
# refresh (Selenium-driven login), so you don't need to run the manual
# flow above every day. SECURITY: TOTP_SECRET is the seed your 2FA app
# uses to generate codes — combined with PIN, this is permanent full
# login access to your real account on disk. Leave all 3 blank to skip
# auto-login and keep doing the manual refresh above instead.
UPSTOX_USERNAME=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=


# Shared across backtest/dryrun/reset-db unless a command-specific var below overrides it.
TRADING_CAPITAL=100000.0
INTRADAY_LEVERAGE=4.0
TRADING_DIRECTION=both

# ── ASSET COVERAGE STATUS ──────────────────────────────────────────────────────
# commodity (MCX CRUDEOILM/NATGASMINI): fully wired for both `backtest` and
#            `dryrun` (live_dryrun.py's is_commodity mode).
# equity (NSE): fully wired for both `backtest` and `dryrun` (live_dryrun.py's
#            default/non-commodity mode, screener-selected top-N symbols).
# options: `backtest --asset options` works (DirectionalOptionBuyer via
#            MultiAssetBacktester). `dryrun --asset options` is NOT implemented
#            -- there is no live/paper options signal loop yet -- and cli.py
#            will refuse to start it rather than silently running the wrong
#            strategy. Backtest options here, don't dryrun it.
# In all cases: this is paper trading. No real orders are placed anywhere in
# this codebase yet (UpstoxBroker is always constructed with dry_run=True) --
# see backend/live_dryrun.py's DryRunner / MultiAssetLiveRunner.

# ── BACKTEST DEFAULTS (python3 cli.py backtest) ────────────────────────────────
BACKTEST_ASSET=commodity
# Space-separated symbols, e.g. "CRUDEOILM NATGASMINI" or "RELIANCE HDFCBANK TCS". Blank = asset default.
BACKTEST_SYMBOLS=
BACKTEST_RISK_PCT=5.0
# Blank = fall back to INTRADAY_LEVERAGE above. Set here to use a different leverage for backtests than live dryrun.
BACKTEST_LEVERAGE=4.0
BACKTEST_FROM=
BACKTEST_TO=
BACKTEST_EQUITY_TOP_N=15
# true = full session bars; false (default) = commodity's evening US-overlap window only (18:30-22:00 IST) -- this is the session the validated backtest results were produced with.
BACKTEST_FULL_SESSION=false

# ── DRY RUN DEFAULTS (python3 cli.py dryrun) ───────────────────────────────────
# Lets `python3 cli.py dryrun` run with zero CLI flags -- edit these instead of
# passing --asset/--risk-pct/--interval on the command line.
DRYRUN_ASSET=commodity
DRYRUN_RISK_PCT=5.0
# Blank = fall back to INTRADAY_LEVERAGE above. Set here to use a different leverage for live dryrun than backtests.
DRYRUN_LEVERAGE=4.0
DRYRUN_INTERVAL=30
DRYRUN_EQUITY_TOP_N=15
# Space-separated to override the default symbol list, e.g. "CRUDEOILM NATGASMINI". Blank = use asset default.
DRYRUN_SYMBOLS=CRUDEOILM NATGASMINI

# ── SAFETY LIMITS (dryrun; apply automatically once live order placement is wired up) ──
# Halts new entries for the rest of the day once realized loss hits this % of
# the capital the process started the day with. Existing open positions are
# still managed/exited normally -- only new entries stop.
MAX_DAILY_LOSS_PCT=5.0
# How often (minutes) the running dryrun process proactively re-validates its
# Upstox token; also re-checked immediately if the broker's 401 circuit
# breaker trips, so a token that dies mid-day doesn't fail silently for hours.
TOKEN_CHECK_INTERVAL_MIN=15

# ── TELEGRAM ALERTS (optional but recommended) ────────────────────────────────
# Alerts on: expired/invalid broker token, every trade opened/closed, every
# failed entry, and any exit that couldn't complete (needs manual action).
# Blank = disabled, bot runs fine without it. Get BOT_TOKEN from @BotFather;
# get CHAT_ID by messaging your bot once, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

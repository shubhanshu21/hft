# ==============================================================================
# Trading framework -- environment template.
# Copy to backend/.env and fill in. NEVER commit .env (it holds credentials), and keep its mode at 600:
#   chmod 600 backend/.env backend/var/cache/upstox_token.json
#
# Sections marked LEGACY are read only by the retired intraday runners (engine/live_dryrun.py,
# engine/live_trading.py, engine/watchdog.py). Nothing is switched on in them, but the code is kept (see CLAUDE.md),
# so the variables are still documented here. The three engines that actually run are described in the first section.
# Any CLI flag overrides its .env value for that run only.
# ==============================================================================

# ── THE THREE PAPER ENGINES THAT RUN (see CLAUDE.md / markets/README.md) ───────
# CRYPTO_DIP_REVERSAL (Rs1L, every 5 min) | MCX_TREND_CARRY (Rs2.5L, 09:10 + 23:40 IST) | RESULTS_GAP (Rs1L, intraday)
# Their settings live in their strategy modules and engine files; these are the ones that can be changed from here.
MCX_TREND_CARRY_CAPITAL=250000          # account size; below ~Rs2-2.5L whole-lot minimums starve it of trades
MCX_TREND_CARRY_EXPOSURE=1.5            # notional multiple
RESULTS_GAP_LEVERAGE=5.0                # intraday MIS notional multiple (user: 3x 2026-10-24, 5x 2026-10-29); capped per stock at Upstox's real MIS leverage
# Portfolio ceilings for crypto (2026-10-26). 0 = OFF, which is the shipped default: switching them on changes how the paper
# record would have traded. MAX_LEVERAGE (3x) in the engine is PER POSITION; with 5 open that allows ~4.3x the account.
CRYPTO_MAX_TOTAL_NOTIONAL_X=0           # sum of open notional as a multiple of the account, e.g. 4.0 to enable
CRYPTO_MAX_TOTAL_RISK_PCT=0             # loss if EVERY open position hit its stop, as a fraction of it, e.g. 0.2 to enable
# Real orders on Delta Exchange India's DEMO account (never the live one). OFF: the demo wallet's margin clamps orders below
# the size this engine means to trade. Turning it on needs BOTH this flag AND all three gates in engine/safety_gate.py.
DELTA_PLACE_REAL_ORDERS=false
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
# The website's backtest API (engine/backtest_api.py, port 8000 behind nginx at /api/). READ endpoints and starting a
# backtest are open; DELETING runs and the paper-account reset require this token in the X-API-Token header. Blank = those
# endpoints refuse every request (fail closed). The web page asks for it once and keeps it in the browser.
BACKTEST_ADMIN_TOKEN=

# ── UPSTOX CREDENTIALS (the only broker account) ──────────────────────────────
# From https://developer.upstox.com/
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1/

# The daily ACCESS_TOKEN is NOT stored here -- it changes every day, so it is cached in
# var/cache/upstox_token.json (written by services/auth). UPSTOX_ACCESS_TOKEN below is only a
# fallback used if that cache file doesn't exist yet; leave it blank.
UPSTOX_ACCESS_TOKEN=

# Optional headless daily token refresh (services/auth/upstox_auto_login.py). Leave all three
# blank to refresh manually with `python3 -m services.auth.upstox_auth` instead.
# SECURITY: TOTP_SECRET + PIN together are permanent full login access to the real account.
UPSTOX_USERNAME=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# ── LEGACY MARKET COVERAGE (retired runners only) ─────────────────────────────
# Currency (NSE NCD) and equity (NSE NIFTY50) ran in one paper daemon (engine/live_dryrun.py); that daemon and those
# strategies were retired 2026-10-07/2026-10-21 and the service is disabled. MCX commodity is TRADED again (paper) by
# engine/mcx_trend_carry.py since 2026-10-15, and crypto by engine/crypto_dip_reversal.py since 2026-10-21.
# Everything is paper trading: no real order is placed anywhere unless all three LIVE TRADING GATES (bottom) agree.

# ── SHARED TRADING DEFAULTS (legacy runners / reset-db) ───────────────────────
TRADING_CAPITAL=100000.0
INTRADAY_LEVERAGE=4.0
TRADING_DIRECTION=both            # both | long-only | short-only
ALLOW_SHORTS=true                 # false = never open a short, regardless of the line above

# ── DRY RUN (python3 cli.py dryrun -- the 24/7 paper-trading daemon) ───────────
DRYRUN_SYMBOLS=USDINR             # NSE currency pairs (USDINR EURINR GBPINR); blank = USDINR
DRYRUN_INCLUDE_EQUITY=false       # true = also trade the fixed NIFTY50 universe (49 names, opt-in)
DRYRUN_RISK_PCT=4.0
# DRYRUN_LEVERAGE blank = INTRADAY_LEVERAGE.
DRYRUN_LEVERAGE=5.0
DRYRUN_INTERVAL=30                # seconds between scans

# ── PER-MARKET RISK & LEVERAGE (override the DRYRUN_* values above, per market) ─
CURRENCY_RISK_PCT=4.0
CURRENCY_LEVERAGE=5.0
EQUITY_RISK_PCT=4.0
EQUITY_LEVERAGE=5.0
# Per-symbol overrides live in code (engine/live_dryrun.py _SYMBOL_RISK_PCT_OVERRIDE /
# _SYMBOL_LEVERAGE_OVERRIDE), not here.

# ── MARKET ON/OFF SWITCHES (false = no new entries for that market) ────────────
ENABLE_CURRENCY_TRADING=true
ENABLE_EQUITY_TRADING=false       # off since 2026-10-07: no edge after real fills (docs/FILL_MODEL_AUDIT.md)

# ── STRATEGY SWITCHES ──────────────────────────────────────────────────────────
# Which strategies run in each market -- comma-separated, names of the strategy folders under
# markets/<market>/. A strategy dropped into the code never trades until it is named here.
# See core/strategy.py for the contract; there is no separate guide file, markets/README.md has the folder rules.
# Optional per-strategy risk: <MARKET>_<STRATEGY>_RISK_PCT, e.g. EQUITY_SWING_RISK_PCT=1.0
# None is switched on: the scalpers were deleted 2026-10-10, equity/currency 2026-10-21 (git history has them). This switch
# only feeds the retired runners -- the three live engines name their strategy in code.
CURRENCY_STRATEGIES=
EQUITY_STRATEGIES=
# Daily-return-autocorrelation regime gate (core/regime.py) on the NIFTY50 index for ALL equity entries. Unvalidated, so off.
USE_EQUITY_REGIME_FILTER=false
# VWAP/RSI mean-reversion setup. Off: failed out-of-sample (on MCX crude, since removed) and the
# other symbols had too few trades to validate. Its thresholds are hardcoded in entry_signal.py.
ENABLE_MEAN_REVERSION=false

# ── SAFETY LIMITS / MONEY MANAGEMENT ───────────────────────────────────────────
# Daily kill switch: halts new entries for the rest of the day once realized loss hits this % of
# day-start capital (open positions are still managed and exited).
MAX_DAILY_LOSS_PCT=5.0
# Per-market cooldown: when one market loses this % of day-start capital it pauses for
# MARKET_COOLDOWN_MINUTES (1.5x / 2x on repeat breaches); the other markets keep trading.
MAX_MARKET_DAILY_LOSS_PCT=3.0
MARKET_COOLDOWN_MINUTES=60
# Portfolio heat cap: total stop-distance risk across ALL open positions, % of capital.
# Researched convention: 4-8% swing, up to ~10% for tight-stop scalpers. Code default 8.0.
MAX_PORTFOLIO_HEAT_PCT=8.0
# Margin is ONE pool at the broker. Sizing here is margin-bound (one trade routinely uses 80-100% of
# capital as margin), so a new entry is SIZED TO THE MARGIN STILL FREE rather than rejected. 100 = the
# whole account, so the first position is sized exactly as validated. Lower these only if you want
# every position smaller (90 / 50 once blocked essentially every entry). Optional per-market limits:
# CURRENCY_MAX_MARGIN_PCT / EQUITY_MAX_MARGIN_PCT.
MAX_MARGIN_UTILIZATION_PCT=100.0
MAX_MARKET_MARGIN_UTILIZATION_PCT=100.0

# Real Upstox margin (engine/margin_rates.py). LEVERAGE settings elsewhere in this file are only an UPPER BOUND: sizing never uses more than
# Upstox gives for that symbol, and a symbol whose ONE lot needs more margin than the capital does not trade. Brokers change margins and lot
# sizes at any time, so the rates are re-read every MARGIN_REFRESH_MIN minutes and the exact order is re-checked with Upstox before each entry.
MARGIN_REFRESH_MIN=60
MARGIN_MAX_AGE_HOURS=6         # a cached rate older than this is not trusted
MARGIN_VERIFY=strict           # strict: skip an entry whose margin cannot be verified. off: tests only

# Session hours come from Upstox every day (core/sessions.py), so special / shortened sessions need no config.
# Upstox does NOT publish its auto square-off time through any API (it is only announced: currency 16:30, equity 15:00-15:15), so the
# exits are set as minutes BEFORE the day's real close. Defaults leave the account flat before those announcements; override only if Upstox
# announces a new time:
# CURRENCY_SQUAREOFF_BEFORE_CLOSE_MIN=35    CURRENCY_LAST_ENTRY_BEFORE_CLOSE_MIN=50
# EQUITY_SQUAREOFF_BEFORE_CLOSE_MIN=35      EQUITY_LAST_ENTRY_BEFORE_CLOSE_MIN=45
# Max concurrent open equity positions in the same sector.
MAX_POSITIONS_PER_SECTOR=1
# Drawdown-scaled position sizing is always on (5/10/15% drawdown -> 10/25/50% smaller size);
# it has no switch -- see DryRunner._drawdown_risk_scale().

# ── OPERATIONS ─────────────────────────────────────────────────────────────────
# How often (minutes) the daemon re-validates its Upstox token (also re-checked immediately if the
# broker returns a 401).
TOKEN_CHECK_INTERVAL_MIN=15
# A failed headless login is retried after TOKEN_RETRY_SEC (up to TOKEN_MAX_FAST_RETRIES times), then every TOKEN_CHECK_INTERVAL_MIN.
# Any process that needs a token first adopts one another process already saved (Upstox allows one active token per app).
TOKEN_RETRY_SEC=60
TOKEN_MAX_FAST_RETRIES=5
# How often (minutes) to sample live bid/ask per symbol WHILE ITS MARKET IS OPEN; feeds the adaptive
# slippage model (core/slippage.py, var/logs/spread_samples.csv).
SPREAD_SAMPLE_INTERVAL_MIN=5

# ── TELEGRAM ALERTS (optional) ─────────────────────────────────────────────────
# Alerts: daemon start/stop, entries/exits, errors, kill-switch trips, token failures, end-of-day
# summary. Blank = disabled. Get the bot token from @BotFather; get the chat id by messaging your bot
# once, then open https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LIVE TRADING GATE (engine/safety_gate.py) ──────────────────────────────────
# All three gates must agree before any real order is placed. This env flag is Gate 2; Gate 1 is
# KILL_SWITCH_ENGAGED in engine/safety_gate.py (source only); Gate 3 is the armed-state file created by
# `python3 cli.py arm-live-trading`. The crypto engine's Delta demo orders need these too (component 'delta'),
# on top of DELTA_PLACE_REAL_ORDERS above.
ALLOW_LIVE_TRADING=false


# ── Upstox SANDBOX (order-request rehearsal only; never trades live) ─────────────────────────────────────────────────────────────
# Developer Apps -> create a SANDBOX app -> Access Token -> Generate (valid 30 days). Leave empty to disable.
UPSTOX_SANDBOX_API_KEY=
UPSTOX_SANDBOX_API_SECRET=
UPSTOX_SANDBOX_TOKEN=
SANDBOX_REHEARSAL=true

# ── PULLBACK ENTRY (legacy runners only) ──────────────────────────────────────────────────────────────────────────────────
# FRAC = how far (in stop distances) better than the signal a resting limit is placed; BARS = how long it may wait; THROUGH = fill haircut. <SYMBOL>_ beats <MARKET>_. FRAC unset/0 = off.
# EQUITY_PULLBACK_FRAC=0.15
# EQUITY_PULLBACK_THROUGH=0.02
# EQUITY_PULLBACK_BARS=3

# ── LEGACY: Binance spot paper trader (removed; git history has engine/crypto_paper.py) ──────────────────────────────
ENABLE_CRYPTO_TRADING=false              # legacy: nothing reads this except the removed Binance spot paper trader
CRYPTO_SYMBOLS=BTCUSDT ETHUSDT SOLUSDT
CRYPTO_CAPITAL_USDT=500
CRYPTO_REBALANCE_BAND=0.10
CRYPTO_STRATEGY=blend
CRYPTO_ROUTER_WEIGHT=0.5

# Leverage multiplies every target (spot holds a long up to 1x a coin's share; shorts and the part of a long above 1x are USDT-M perpetuals, isolated margin). 1.5x is the chosen level
# (research note kept from git history: a 1.0-3.0x grid put the return/drawdown plateau at 1.25-1.75x.)
CRYPTO_LEVERAGE=1.5
# Execution: "demo" = REAL market orders on BINANCE'S DEMO EXCHANGE (never the live one; services/broker/binance_demo.py refuses any other host); "paper" = our own simulation;
# "auto" = demo when both keys below are set, else paper. Create the demo keys at https://demo.binance.com/en/my/settings/api-management (Demo Trading -> API Key Management, enable trading).
CRYPTO_EXECUTION=auto
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Order-book recorder (engine/depth_recorder.py, hft-depth-recorder.service): instruments to record. NIFTY / BANKNIFTY = front-month index futures.
# NIFTYOPT = the live Nifty option chain (current weekly expiry, ATM +-DEPTH_OPTION_STRIKES, one row per option every DEPTH_OPTION_EVERY_S s).
# DEPTH_EVERY_S > 0 samples the other instruments (default 0 = keep every update, needed for order flow).
# DEPTH_SYMBOLS=USDINR EURINR GBPINR SILVERMIC GOLDTEN CRUDEOILM NIFTY BANKNIFTY RELIANCE HDFCBANK ICICIBANK INFY TCS NIFTYOPT
# DEPTH_OPTION_STRIKES=10
# DEPTH_OPTION_EVERY_S=15
# DEPTH_EVERY_S=0



[Unit]
Description=HFT backtest API for the web frontend (127.0.0.1:8000, nginx publishes /api/)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/html/hft/backend
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m engine.backtest_api
Restart=on-failure
RestartSec=5
# Reads archived candles and runs strategy code only: no Upstox calls, no paper-trading database, no orders.

[Install]
WantedBy=default.target

[Unit]
Description=Crypto trend_breakout paper trading schedule

[Timer]
# 2 minutes after every 4-hour candle closes (00/04/08/12/16/20 UTC = 05:32, 09:32, 13:32, 17:32, 21:32, 01:32 IST); crypto never closes.
OnCalendar=*-*-* 00,04,08,12,16,20:02:00 UTC
Persistent=true

[Install]
WantedBy=timers.target

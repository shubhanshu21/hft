[Unit]
Description=MCX trend + carry paper trading (re-checked every 10 trading days, daily mark-to-market; paper only, no real orders)

[Service]
Type=oneshot
WorkingDirectory=/var/www/html/hft/backend
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m engine.mcx_trend_carry
TimeoutStartSec=20min

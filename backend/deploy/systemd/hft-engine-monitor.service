[Unit]
Description=Telegram alert if a paper engine (crypto / MCX) stops running or the Upstox login expires

[Service]
Environment=PYTHONUNBUFFERED=1
Type=oneshot
WorkingDirectory=/var/www/html/hft/backend
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m engine.engine_monitor
TimeoutStartSec=5min

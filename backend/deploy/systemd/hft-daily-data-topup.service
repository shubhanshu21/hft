[Unit]
Description=Nightly maintenance: real MCX / NSE currency / NSE equity data top-up, DB backup, trade audit, archive-freshness check

[Service]
Type=oneshot
WorkingDirectory=/var/www/html/hft/backend
# ONE command that runs every step and carries on past a failing one (systemd would stop a oneshot at the first failing
# ExecStart, silently skipping the DB backup and later top-ups). See engine/nightly.py. Failures go to Telegram.
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m engine.nightly
TimeoutStartSec=3h

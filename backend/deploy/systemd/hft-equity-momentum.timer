[Unit]
Description=Equity momentum paper trading schedule

[Timer]
# 09:20 IST: a due rebalance (first build, or the first trading day after a quarter end) trades at the live price after the open.
OnCalendar=Mon..Fri *-*-* 09:20:00 Asia/Kolkata
# 15:40 IST: after the close -- daily account snapshot only.
OnCalendar=Mon..Fri *-*-* 15:40:00 Asia/Kolkata
Persistent=false

[Install]
WantedBy=timers.target

[Unit]
Description=Daily real MCX commodity + NSE currency + NSE index futures data top-up (CRUDEOILM/NATGASMINI/GOLDM/SILVERMIC/COPPER, USDINR/EURINR/GBPINR/JPYINR, NIFTY/BANKNIFTY, via Upstox)

[Service]
Type=oneshot
WorkingDirectory=/var/www/html/hft/backend
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m real_commodity_data --topup
# Added 2026-09-18: currency derivatives top-up, same daily job (multiple ExecStart=
# lines run sequentially for a oneshot service) rather than a second timer -- both are
# small, fast, real-data top-ups against the same broker/account.
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m real_currency_data --topup
# Added 2026-09-18: NSE index futures (NIFTY/BANKNIFTY) top-up -- still under
# evaluation (only ~2.5 months of real archive so far, not yet live), but growing
# the archive daily now means it'll be ready to re-validate sooner.
ExecStart=/var/www/html/hft/backend/.venv/bin/python3 -m real_index_futures_data --topup
